<UserControl x:Class="MovingPreviewPlugin.MovingPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1A1A1A">

    <Grid x:Name="RootGrid"
          ClipToBounds="True"
          Background="Transparent"
          MouseWheel="OnMouseWheel"
          MouseLeftButtonDown="OnMouseLeftButtonDown"
          MouseLeftButtonUp="OnMouseLeftButtonUp"
          MouseMove="OnMouseMove">

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="位置をリセット" Click="OnResetPosition"/>
                <Separator/>
                <MenuItem Header="{Binding LockMenuHeader}" Click="OnToggleLock"/>
                <Separator/>
            </ContextMenu>
        </Grid.ContextMenu>

        <Image Source="{Binding PreviewImage}"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               IsHitTestVisible="False">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                    <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,8,10,0"
                Background="#CC333333" CornerRadius="3" Padding="5,2"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="固定中" Foreground="#FFB347" FontSize="10"
                       FontWeight="SemiBold" IsHitTestVisible="False"/>
        </Border>
    </Grid>
</UserControl>